# Keep real keys in a local .env file or environment-variable manager. Never commit it.
# This adapter supports OpenAI-compatible vision chat-completions providers (e.g. OpenAI, Google Gemini).

# Option 1: Google Gemini (OpenAI-compatible endpoint)
AI_API_KEY=replace_with_your_key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# Option 2: OpenAI
# AI_API_KEY=replace_with_your_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Google Classroom OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=108670757768406893528
GOOGLE_CLIENT_SECRET=replace_with_your_client_secret
